<Window x:Class="TodoList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todo List - Лабораторная" Height="600" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="TasksGrid" Grid.Column="0" Margin="10" AutoGenerateColumns="False"
                  SelectionChanged="TasksGrid_SelectionChanged" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Срок" Binding="{Binding DueDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="90"/>
                <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="90"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Название:"/>
            <TextBox x:Name="TitleBox" Margin="0,5"/>

            <TextBlock Text="Описание:"/>
            <TextBox x:Name="DescBox" Margin="0,5" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

            <TextBlock Text="Срок выполнения:"/>
            <DatePicker x:Name="DueDatePicker" Margin="0,5"/>

            <TextBlock Text="Приоритет:"/>
            <ComboBox x:Name="PriorityBox" Margin="0,5">
                <ComboBoxItem Content="Low"/>
                <ComboBoxItem Content="Medium"/>
                <ComboBoxItem Content="High"/>
            </ComboBox>

            <TextBlock Text="Статус:"/>
            <ComboBox x:Name="StatusBox" Margin="0,5">
                <ComboBoxItem Content="NotStarted"/>
                <ComboBoxItem Content="InProgress"/>
                <ComboBoxItem Content="Completed"/>
            </ComboBox>

            <Button Content="Добавить" Margin="0,10,0,0" Click="AddButton_Click" Height="30"/>
            <Button Content="Сохранить изменения" Margin="0,5" Click="UpdateButton_Click" Height="30"/>
            <Button Content="Удалить" Margin="0,5" Click="DeleteButton_Click" Height="30" Background="#FFDDDDDD"/>
        </StackPanel>
    </Grid>
</Window>